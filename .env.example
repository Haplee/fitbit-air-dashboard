# Generate a bcrypt hash with: pnpm auth:hash
APP_PASSWORD_HASH=
# 32+ random bytes. Generate: openssl rand -base64 48
AUTH_SECRET=

# Neon PostgreSQL connection string (use pooled connection string in Vercel)
DATABASE_URL=

# Google Health API / OAuth 2.0
GOOGLE_HEALTH_API_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Generate 32 random bytes encoded as base64: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Vercel Cron secret, at least 32 random characters
CRON_SECRET=
