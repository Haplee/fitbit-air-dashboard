# Initial owner password hash (generate with: npm run auth:hash)
APP_PASSWORD_HASH=
# 32+ random bytes (generate securely, e.g. openssl rand -base64 48)
AUTH_SECRET=

# Supabase PostgreSQL Transaction Pooler URI (server-side only).
# Supabase Dashboard > Project > Connect > Transaction pooler.
# Keep the password private. Do not prefix this variable with NEXT_PUBLIC_.
DATABASE_URL=

# Google Health API / OAuth 2.0
GOOGLE_HEALTH_API_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Vercel Cron secret (at least 32 random characters)
CRON_SECRET=
